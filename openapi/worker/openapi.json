  "info": {
    "title": "Ramalama-Worker REST API",
    "version": "1.0"
  },
  "tags": [
    {
      "name": "worker-api",
      "description": ""
    },
    {
      "name": "worker-proxy",
      "description": ""
    }
  ],
  "openapi": "3.0.3",
  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "code": {
            "type": "integer",
            "description": "Error code"
          },
          "status": {
            "type": "string",
            "description": "Error name"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "errors": {
            "type": "object",
            "description": "Errors",
            "additionalProperties": {}
          }
        },
        "additionalProperties": false
      },
      "PaginationMetadata": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          },
          "first_page": {
            "type": "integer"
          },
          "last_page": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "previous_page": {
            "type": "integer"
          },
          "next_page": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "AvailableModelDTO": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "size": {
            "type": "integer"
          },
          "modified": {
            "type": "number"
          }
        },
        "required": [
          "modified",
          "name",
          "size"
        ],
        "additionalProperties": false
      },
      "InferenceOptionsDTO": {
        "type": "object",
        "properties": {
          "engine": {
            "type": "string"
          }
        },
        "required": [
          "engine"
        ],
        "additionalProperties": false
      },
      "ServeOptionsDTO": {
        "type": "object",
        "properties": {
          "expires_after": {
            "type": "integer"
          }
        },
        "required": [
          "expires_after"
        ],
        "additionalProperties": false
      },
      "ModelServeRequestDTO": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          },
          "inference_options": {
            "$ref": "#/components/schemas/InferenceOptionsDTO"
          },
          "serve_options": {
            "$ref": "#/components/schemas/ServeOptionsDTO"
          }
        },
        "required": [
          "inference_options",
          "model",
          "serve_options"
        ],
        "additionalProperties": false
      },
      "ModelServeResponseDTO": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string"
          }
        },
        "required": [
          "model_id"
        ],
        "additionalProperties": false
      },
      "ModelStopRequestDTO": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string"
          }
        },
        "required": [
          "model"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "DEFAULT_ERROR": {
        "description": "Default error response",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UNPROCESSABLE_CONTENT": {
        "description": "Unprocessable Content",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}